# Gemini API Key (optional - app works without it via rule-based engine)
# Get one at: https://aistudio.google.com/api-keys
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Preferred Gemini Model (optional - defaults to gemini-3.6-flash)
# Available: gemini-3.6-flash, gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-2.5-flash
GEMINI_MODEL=gemini-3.6-flash

# Port for local development server (optional - defaults to 3000)
PORT=3000
