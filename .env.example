# Gemini API Key (optional - app works without it via rule-based engine)
# Get one at: https://aistudio.google.com/api-keys
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Preferred Gemini Model (optional - defaults to gemini-2.5-flash)
# Available: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Port for local development server (optional - defaults to 3000)
PORT=3000
